diff --git a/src/libslic3r/CMakeLists.txt b/src/libslic3r/CMakeLists.txt
index 9b67d7ab..d56806ec 100644
--- a/src/libslic3r/CMakeLists.txt
+++ b/src/libslic3r/CMakeLists.txt
@@ -497,7 +497,9 @@ set(CGAL_DO_NOT_WARN_ABOUT_CMAKE_BUILD_TYPE ON CACHE BOOL "" FORCE)
 cmake_policy(PUSH)
 cmake_policy(SET CMP0011 NEW)
 find_package(CGAL REQUIRED)
-find_package(OpenCV REQUIRED core)
+if (NOT SLIC3R_ANDROID)
+    find_package(OpenCV REQUIRED core)
+endif ()
 cmake_policy(POP)
 
 add_library(libslic3r_cgal STATIC
@@ -537,8 +539,20 @@ target_compile_definitions(libslic3r PUBLIC -DUSE_TBB -DTBB_USE_CAPTURED_EXCEPTI
 target_include_directories(libslic3r PRIVATE ${CMAKE_CURRENT_SOURCE_DIR} PUBLIC ${CMAKE_CURRENT_BINARY_DIR})
 target_include_directories(libslic3r SYSTEM PUBLIC ${EXPAT_INCLUDE_DIRS})
 
+if (SLIC3R_ANDROID)
+    # Android build: no OpenCV. The sources that need it, or OCCT fonts, are
+    # dropped and their entry points are provided by stubs (SLIC3R_ANDROID_STUBS,
+    # set by the parent project, which also sets OpenCASCADE_DIR).
+    get_target_property(_slic3r_srcs libslic3r SOURCES)
+    list(FILTER _slic3r_srcs EXCLUDE REGEX "(Format/svg|Shape/TextShape|ObjColorUtils)\\.(cpp|hpp)$")
+    set_target_properties(libslic3r PROPERTIES SOURCES "${_slic3r_srcs}")
+    target_sources(libslic3r PRIVATE ${SLIC3R_ANDROID_STUBS})
+    set(_slic3r_opencv_lib "")
+else ()
+    set(OpenCASCADE_DIR "${CMAKE_PREFIX_PATH}/lib/cmake/occt")
+    set(_slic3r_opencv_lib opencv_world)
+endif ()
 # Find the OCCT and related libraries
-set(OpenCASCADE_DIR "${CMAKE_PREFIX_PATH}/lib/cmake/occt")
 find_package(OpenCASCADE REQUIRED)
 target_include_directories(libslic3r SYSTEM PUBLIC ${OpenCASCADE_INCLUDE_DIR})
 
@@ -581,7 +595,7 @@ target_link_libraries(libslic3r
         libigl
         libnest2d
         miniz
-        opencv_world
+        ${_slic3r_opencv_lib}
     PRIVATE
         ${CMAKE_DL_LIBS}
         ${EXPAT_LIBRARIES}
@@ -609,7 +623,7 @@ target_link_libraries(libslic3r
 if(NOT WIN32)
     # Link freetype for OCCT dependency (CAD operations need font rendering)
     target_link_libraries(libslic3r PRIVATE ${FREETYPE_LIBRARIES})
-    if (NOT APPLE)
+    if (NOT APPLE AND NOT ANDROID)
         target_link_libraries(libslic3r PRIVATE fontconfig)
     endif()
 endif()
