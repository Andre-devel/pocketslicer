+    // PocketSlicer: chamber_cooling_mode as Snapmaker Orca computes it (src/libslic3r/GCode.cpp there),
+    // used by the Snapmaker U1 start G-code: 0 keep warm, 1 weak cooling (a filament with
+    // vitrification <= 70), 2 strong cooling (<= 50). Snapmaker Orca also skips filaments with
+    // filament_is_high_temperature, an option Orca does not have.
+    {
+        int chamber_cooling_mode = 0;
+        for (unsigned int extruder : tool_ordering.all_extruders()) {
+            const int vitrification = m_config.temperature_vitrification.get_at(extruder);
+            if (vitrification <= 50) {
+                chamber_cooling_mode = 2;
+                break;
+            }
+            if (vitrification <= 70)
+                chamber_cooling_mode = 1;
+        }
+        this->placeholder_parser().set("chamber_cooling_mode", new ConfigOptionInt(chamber_cooling_mode));
+    }
